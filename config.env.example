# Macron Agent settings. `macron setup` writes this file for you:
#   ~/.macron/config.env   (only you can read it; never commit it)
# Every setting can also be an environment variable. Names starting with
# WAZE_ work as well as MACRON_ (the public Macron's .env can be reused).

# --- the bot and its owner -----------------------------------------------------
# The token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:replace-me
# Your numeric Telegram id (@userinfobot shows it). The agent answers its
# owners and nobody else; several ids are separated by commas.
MACRON_OWNERS=
# Where a "day" starts for schedules and statistics.
MACRON_TIMEZONE=Asia/Tehran

# --- the first model ---------------------------------------------------------------
# On the first start this becomes the provider "default". More providers are
# added, switched and removed in Telegram: /admin -> providers.
# Any OpenAI-compatible address (.../v1), Anthropic's, or an OpenAI Responses
# endpoint (.../v1/responses) works.
MACRON_API_URL=https://api.openai.com/v1
MACRON_API_KEY=replace-me
MACRON_MODEL=gpt-5

# --- where things live (defaults shown) ----------------------------------------
# The agent's home: database, SOUL.md, USER.md, MEMORY.md, skills, workspaces.
# MACRON_HOME=~/.macron
# MACRON_DB=~/.macron/macron.db

# --- optional --------------------------------------------------------------------
# Raises the GitHub API rate limit for the GitHub tool.
GITHUB_TOKEN=
# A local Bot API server (files up to 2 GB) instead of api.telegram.org.
# MACRON_TELEGRAM_API=
# MACRON_TELEGRAM_LOCAL=1
# Send the tools' traffic through HTTP(S)_PROXY.
# MACRON_USE_ENV_PROXY=1
